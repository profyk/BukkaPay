{
  "buildCommand": "pnpm --filter @workspace/bukkapay-admin run build",
  "outputDirectory": "artifacts/bukkapay-admin/dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://api.bukkapay.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "VERCEL": "1"
  }
}
