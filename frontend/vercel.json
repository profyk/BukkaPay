{
    "buildCommand": "npx expo export --platform web",
    "outputDirectory": "dist",
    "installCommand": "npm install --legacy-peer-deps",
    "framework": null,
    "env": {
      "EXPO_NO_TELEMETRY": "1",
      "CI": "1"
    },
    "rewrites": [
      { "source": "/(.*)", "destination": "/index.html" }
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
  