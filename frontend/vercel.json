{
  "buildCommand": "npx expo export --platform web && rm -rf .vercel",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": null,
  "env": {
    "EXPO_NO_TELEMETRY": "1",
    "CI": "1"
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
