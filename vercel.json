{
  "buildCommand": "pnpm --filter @workspace/bukkapay-admin run build",
  "outputDirectory": "artifacts/bukkapay-admin/dist",
  "installCommand": "pnpm install --frozen-lockfile=false",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/admin/:path*",
      "destination": "https://api.bukkapay.com/admin/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "VERCEL": "1"
  }
}
