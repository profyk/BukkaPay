DATABASE_URL=postgresql://user:password@localhost:5432/bukkapay
EXTERNAL_DATABASE_URL=postgresql://user:password@localhost:5432/bukkapay
# Pool per process; (DB_POOL_SIZE + DB_MAX_OVERFLOW) x WEB_CONCURRENCY x instances must fit the DB limit.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
# true when DATABASE_URL points at a transaction-mode pooler (Supabase :6543, PgBouncer)
DB_PGBOUNCER=false
REDIS_URL=redis://localhost:6379/0

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

PAYSTACK_SECRET_KEY=sk_test_...

PORT=5000
WEB_CONCURRENCY=4
ENV=development

# Stitch (instant bank payments + disbursements)
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=

# BukkaPay's receiving bank account (for Stitch top-ups)
BUKKAPAY_ACCOUNT_NAME=BukkaPay (Pty) Ltd
BUKKAPAY_BANK_ID=fnb
BUKKAPAY_ACCOUNT_NUMBER=
BUKKAPAY_BRANCH_CODE=250655

# WebAuthn / passkeys
WEBAUTHN_RP_ID=bukkapay.com
WEBAUTHN_ORIGIN=https://app.bukkapay.com

# Admin
ADMIN_API_KEY=your-secret-master-key-here
ADMIN_ALLOWED_ORIGINS=https://admin.bukkapay.com,https://bukkapay-admin.vercel.app

# CORS
ALLOWED_ORIGINS=

# App URLs
API_BASE_URL=https://api.bukkapay.com
APP_URL=https://app.bukkapay.com

# ─── Network platform (2026-11) ───────────────────────────────────────────
# Fernet key for card PAN/CVV encryption at rest. REQUIRED in production.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CARD_DATA_KEY=
# Supabase Storage (private "documents" bucket for KYC/KYB files). Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
# Sandbox settlement rail (simulated, no real money)
SANDBOX_WEBHOOK_SECRET=change-me
SANDBOX_SETTLEMENT_DELAY_SECONDS=5
PUBLIC_WEB_URL=https://bukkapay.com
MERCHANT_WEB_URL=https://merchant.bukkapay.com

# Card issuing (Visa). "sandbox" = simulated test cards (refused in production);
# "none" until a BIN sponsor + issuer-processor is contracted. See app/cards/issuers.py.
CARD_ISSUER=sandbox
CARD_ISSUER_WEBHOOK_SECRET=

# ── Paymentology (virtual cards) ─ off until enabled; sandbox until switched.
# Get sandbox credentials from Paymentology onboarding. Never commit real values.
PAYMENTOLOGY_ENABLED=false
PAYMENTOLOGY_ENV=sandbox
PAYMENTOLOGY_BASE_URL=
PAYMENTOLOGY_API_KEY=
PAYMENTOLOGY_API_SECRET=
PAYMENTOLOGY_PROGRAM_ID=
PAYMENTOLOGY_WEBHOOK_SECRET=
PAYMENTOLOGY_AUTH_BUDGET_MS=1500

# ── Onafriq (cross-border payouts to banks and mobile wallets) ─ off until enabled.
ONAFRIQ_ENABLED=false
ONAFRIQ_ENV=sandbox
ONAFRIQ_BASE_URL=
ONAFRIQ_CLIENT_ID=
ONAFRIQ_CLIENT_SECRET=
ONAFRIQ_WEBHOOK_SECRET=
# Payout rail for bank / mobile-wallet payouts: mock (tests, local) | onafriq
PAYOUT_RAIL=mock
PAYOUT_QUOTE_TTL_SECONDS=60

# Email one-time codes: Supabase Auth sends them through Resend SMTP
# (Supabase dashboard -> Authentication -> SMTP: smtp.resend.com:465, user "resend",
# password = Resend API key; put {{ .Token }} in the Magic Link template).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Sign in with Google: every OAuth client ID whose tokens the API accepts
# (web, Android, iOS), comma-separated. GOOGLE_CLIENT_ID alone still works.
GOOGLE_CLIENT_IDS=
# Sign in with Apple: iOS bundle ID and web Services ID, comma-separated.
APPLE_CLIENT_IDS=com.bukkapay.app
