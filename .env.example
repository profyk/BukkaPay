DATABASE_URL=postgresql://user:password@localhost:5432/bukkapay
EXTERNAL_DATABASE_URL=postgresql://user:password@localhost:5432/bukkapay
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@bukkapay.com
BANK_PARTNER_API_URL=https://api.bank-partner.example
BANK_PARTNER_API_KEY=your-bank-partner-api-key
BANK_PARTNER_ACCOUNT_ID=your-bank-account-id
BANK_PARTNER_WEBHOOK_SECRET=your-bank-webhook-secret
STRIPE_SECRET_KEY=sk_test_...
PORT=5000
NODE_ENV=development

# Stitch (instant bank payments + disbursements)
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=

# BukkaPay's receiving bank account (for Stitch top-ups)
BUKKAPAY_ACCOUNT_NAME=BukkaPay (Pty) Ltd
BUKKAPAY_BANK_ID=fnb
BUKKAPAY_ACCOUNT_NUMBER=
BUKKAPAY_BRANCH_CODE=250655

# Admin
ADMIN_API_KEY=your-secret-master-key-here
ADMIN_ALLOWED_ORIGINS=https://admin.bukkapay.com,https://bukkapay-admin.vercel.app

# App URLs
API_BASE_URL=https://api.bukkapay.com
APP_URL=https://app.bukkapay.com

# Customer app: Sign in with Google / Apple (public client IDs, not secrets)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_APPLE_SERVICES_ID=

# Card issuing and cross-border payouts (full list and notes: backend/.env.example,
# docs/integrations/paymentology.md, docs/integrations/onafriq.md). Off by default.
CARD_ISSUER=sandbox
PAYMENTOLOGY_ENABLED=false
PAYMENTOLOGY_ENV=sandbox
PAYMENTOLOGY_BASE_URL=
PAYMENTOLOGY_API_KEY=
PAYMENTOLOGY_API_SECRET=
PAYMENTOLOGY_PROGRAM_ID=
PAYMENTOLOGY_WEBHOOK_SECRET=
PAYMENTOLOGY_AUTH_BUDGET_MS=1500
PAYOUT_RAIL=mock
PAYOUT_QUOTE_TTL_SECONDS=60
ONAFRIQ_ENABLED=false
ONAFRIQ_ENV=sandbox
ONAFRIQ_BASE_URL=
ONAFRIQ_CLIENT_ID=
ONAFRIQ_CLIENT_SECRET=
ONAFRIQ_WEBHOOK_SECRET=
